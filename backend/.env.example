# ==========================================
# EduNexus Backend Environment Variables
# ==========================================

# PostgreSQL / Neon Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edunexus?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_for_security
JWT_EXPIRATION_MS=86400000

# Spring AI / LLM Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://api.groq.com/openai

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
